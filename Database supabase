        local pid = tostring(game.PlaceId)
        local r = callRPC("ren_upsert_session", {
            p_session_id  = testSid, p_username = player.Name,
            p_user_id     = player.UserId, p_place_id = tonumber(pid),
            p_job_id      = jid, p_game_name = "Diag Test",
            p_join_url    = "https://www.roblox.com/games/start?placeId=" .. pid,
            p_profile_url = "https://www.roblox.com/users/" .. player.UserId .. "/profile",
            p_executor    = (identifyexecutor and identifyexecutor()) or "Unknown",
            p_timestamp   = os.time(),
        })
        if not r.success then
            local hint = "Jalankan SQL migration ren_* di Supabase."
            if r.code == 401 then hint = "API key salah. Cek Settings → API."
            elseif r.code == 403 or r.code == 42501 then hint = "Grant/RLS block. Jalankan SQL FIX GRANT."
            elseif r.code == 404 then hint = "Function tidak ditemukan. Jalankan SQL migration ren_*."
            elseif r.code == 400 then hint = "Parameter RPC mismatch. Cek definisi function." end
            return showError(
                "ren_upsert_session GAGAL\n" ..
                "Err: " .. tostring(r.err) .. "\n" ..
                "Body: " .. tostring(r.body or "(kosong)"):sub(1, 300),
                hint
            )
        end
        logLine("✓ upsert OK (HTTP " .. r.code .. ")", "ok")

        -- 3. HEARTBEAT
        setStatus("Test ren_heartbeat...", "info")
        local hb = callRPC("ren_heartbeat", { p_session_id = testSid, p_timestamp = os.time() })
        if hb.success then logLine("✓ heartbeat OK", "ok")
        else logLine("⚠ heartbeat: " .. tostring(hb.err), "warn") end

        -- 4. TRACK
        setStatus("Test ren_track_execute...", "info")
        local tr = callRPC("ren_track_execute", {
            p_user_id = player.UserId, p_username = player.Name,
            p_place_id = tonumber(pid), p_game_name = "Diag Test",
            p_script_name = "REN-DIAG", p_timestamp = os.time(),
        })
        if tr.success then logLine("✓ track OK", "ok")
        else logLine("⚠ track: " .. tostring(tr.err), "warn") end

        -- 5. LIST
        setStatus("Test ren_list_sessions...", "info")
        local ls = callRPC("ren_list_sessions", { p_cutoff = os.time() - 300, p_limit = 5 })
        if ls.success then logLine("✓ list OK", "ok")
        else logLine("⚠ list: " .. tostring(ls.err), "warn") end

        -- 6. VERIFY
        setStatus("Verifikasi data di DB...", "info")
        local v = callRPC("ren_get_session", { p_session_id = testSid })
        if v.success and v.body and v.body ~= "[]" and v.body ~= "null" then
            logLine("✓ Data benar-benar masuk tabel sessions!", "ok")
        else
            logLine("⚠ Data tidak terbaca dari DB — cek GRANT SELECT", "warn")
        end

        -- cleanup
        pcall(function() callRPC("ren_delete_session", { p_session_id = testSid }) end)

        logLine("", "info")
        logLine("🚀 Semua OK, mulai tracker...", "ok")

        -- ═══════════════════════════════════════════════════════════
        -- REAL TRACKER
        -- ═══════════════════════════════════════════════════════════
        local State = { lastFullPush = 0, deleted = false,
                        hbInFlight = false, hbQueued = false, trackCache = {} }

        local function getGameName()
            local o, i = pcall(function() return Marketplace:GetProductInfo(game.PlaceId) end)
            if o and type(i) == "table" and i.Name then return i.Name end
            return "Unknown Game"
        end

        local function doFullPush()
            local now = os.time()
            local j = game.JobId ~= "" and game.JobId or "Studio"
            local p = tostring(game.PlaceId)
            local rr = callRPC("ren_upsert_session", {
                p_session_id = sessionId, p_username = player.Name,
                p_user_id = player.UserId, p_place_id = tonumber(p),
                p_job_id = j, p_game_name = getGameName(),
                p_join_url = "https://www.roblox.com/games/start?placeId="..p.."&gameInstanceId="..j,
                p_profile_url = "https://www.roblox.com/users/"..player.UserId.."/profile",
                p_executor = (identifyexecutor and identifyexecutor()) or "Unknown",
                p_timestamp = now,
            })
            if rr.success then State.lastFullPush = now end
        end

        local function heartbeat()
            if State.hbInFlight then State.hbQueued = true; return end
            State.hbInFlight = true
            task.spawn(function()
                local n = os.time()
                if n - State.lastFullPush >= CONFIG.FullPushInterval then doFullPush()
                else callRPC("ren_heartbeat", { p_session_id = sessionId, p_timestamp = n }) end
                State.hbInFlight = false
                if State.hbQueued then State.hbQueued = false; heartbeat() end
            end)
        end

        local function deleteSession()
            if State.deleted then return end
            State.deleted = true
            task.spawn(function()
                callRPC("ren_delete_session", { p_session_id = sessionId })
            end)
        end

        local function trackExecute()
            local k = tostring(game.PlaceId)
            local n = os.time()
            if State.trackCache[k] and (n - State.trackCache[k]) < CONFIG.TrackDebounce then return end
            State.trackCache[k] = n
            task.spawn(function()
                callRPC("ren_track_execute", {
                    p_user_id = player.UserId, p_username = player.Name,
                    p_place_id = tonumber(k), p_game_name = getGameName(),
                    p_script_name = CONFIG.ScriptName, p_timestamp = n,
                })
            end)
        end

        _G.REN = {
            join = function(tid)
                local rr = callRPC("ren_get_session", { p_session_id = tostring(tid) })
                if not rr.success or not rr.body then return false end
                local o, d = pcall(function() return HttpService:JSONDecode(rr.body) end)
                if not o or type(d) ~= "table" or not d[1] or not d[1].job_id then return false end
                pcall(function()
                    Teleport:TeleportToPlaceInstance(tonumber(d[1].place_id), d[1].job_id, player)
                end)
                return true
            end,
            refresh = doFullPush,
            method = methodName,
        }

        -- ✅ Push session DULU sebelum hook (hook bisa throw)
        doFullPush()
        trackExecute()

        -- ✅ Start heartbeat loop lebih awal
        task.spawn(function()
            while not State.deleted do
                task.wait(CONFIG.HeartbeatInterval)
                heartbeat()
            end
        end)

        -- ✅ Hook cleanup dibungkus pcall (BindToClose = server-only)
        pcall(function()
            Players.PlayerRemoving:Connect(function(l)
                if l == player then deleteSession() end
            end)
        end)
        pcall(function()
            game:BindToClose(function() deleteSession(); task.wait(1) end)
        end)

        logLine("", "info")
        logLine("✅ Tracker aktif — GUI hilang 3 detik lagi", "ok")
        showSuccess()
    end)

    if not ok then
        showError(
            "Fatal error saat init:\n" .. tostring(fatal),
            "Ini bug script — screenshot GUI ini ke ChatGPT."
        )
    end
end)
