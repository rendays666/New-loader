-- ═══════════════════════════════════════════════════════════════════
-- DEBUG LOG (di-throttle biar console tidak banjir)
-- ═══════════════════════════════════════════════════════════════════
local lastWarn = {}
local function dbg(tag, msg)
    if not CONFIG.Debug then return end
    local now = os.clock()
    if lastWarn[tag] and now - lastWarn[tag] < 30 then return end
    lastWarn[tag] = now
    warn("[REN] " .. tag .. ": " .. tostring(msg))
end

-- ═══════════════════════════════════════════════════════════════════
-- HTTP
-- ═══════════════════════════════════════════════════════════════════
local rawRequest, methodName
if typeof(request) == "function" then
    rawRequest, methodName = request, "request()"
elseif typeof(http_request) == "function" then
    rawRequest, methodName = http_request, "http_request()"
elseif syn and typeof(syn.request) == "function" then
    rawRequest, methodName = syn.request, "syn.request()"
elseif fluxus and typeof(fluxus.request) == "function" then
    rawRequest, methodName = fluxus.request, "fluxus.request()"
end

if not rawRequest then
    return warn("[REN] No HTTP method available in executor")
end

local function post(url, body)
    local ok, res = pcall(rawRequest, {
        Url = url, Method = "POST",
        Headers = { apikey = CONFIG.KEY, ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok or type(res) ~= "table" then
        return { success = false, err = "request threw: " .. tostring(res) }
    end
    local code  = tonumber(res.StatusCode) or 0
    local rbody = tostring(res.Body or "")
    if code >= 200 and code < 300 then
        return { success = true, code = code, body = rbody }
    end
    return { success = false, code = code, body = rbody,
             err = "HTTP " .. code .. " " .. tostring(res.StatusMessage or "") }
end

-- Retry 1x untuk error jaringan / 5xx. Error 4xx (key salah, fungsi tidak ada,
-- RLS menolak) tidak di-retry karena hasilnya akan sama.
local function callRPC(fnName, payload)
    local url  = CONFIG.URL .. "/rest/v1/rpc/" .. fnName
    local body = HttpService:JSONEncode(payload or {})
    local res
    for attempt = 1, 2 do
        res = post(url, body)
        if res.success then return res end
        if res.code and res.code >= 400 and res.code < 500 then break end
        if attempt < 2 then task.wait(2) end
    end
    dbg(fnName, tostring(res.err) .. " | " .. tostring(res.body or ""):sub(1, 200))
    return res
end

-- ═══════════════════════════════════════════════════════════════════
-- TRACKER
-- ═══════════════════════════════════════════════════════════════════
local State = { lastFullPush = 0, deleted = false, trackCache = {} }
local connections = {}

genv.REN_TRACKER_STOP = function()
    State.deleted = true
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
end

local cachedGameName
local function getGameName()
    if cachedGameName then return cachedGameName end
    local ok, info = pcall(function() return Marketplace:GetProductInfo(game.PlaceId) end)
    if ok and type(info) == "table" and info.Name then
        cachedGameName = info.Name
        return cachedGameName
    end
    return "Unknown Game"
end

local function doFullPush()
    local now = os.time()
    local j = game.JobId ~= "" and game.JobId or "Studio"
    local p = tostring(game.PlaceId)
    local rr = callRPC("ren_upsert_session", {
        p_session_id = sessionId, p_username = player.Name,
        p_user_id = player.UserId, p_place_id = tonumber(p),
        p_job_id = j, p_game_name = getGameName(),
        p_join_url = "https://www.roblox.com/games/start?placeId=" .. p .. "&gameInstanceId=" .. j,
        p_profile_url = "https://www.roblox.com/users/" .. player.UserId .. "/profile",
        p_executor = (identifyexecutor and identifyexecutor()) or "Unknown",
        p_timestamp = now,
    })
    if rr.success then State.lastFullPush = now end
    return rr
end

local function deleteSession()
    if State.deleted then return end
    State.deleted = true
    task.spawn(function()
        callRPC("ren_delete_session", { p_session_id = sessionId })
    end)
end

local function trackExecute()
    local k = tostring(game.PlaceId)
    local n = os.time()
    if State.trackCache[k] and (n - State.trackCache[k]) < CONFIG.TrackDebounce then return end
    State.trackCache[k] = n
    task.spawn(function()
        callRPC("ren_track_execute", {
            p_user_id = player.UserId, p_username = player.Name,
            p_place_id = tonumber(k), p_game_name = getGameName(),
            p_script_name = CONFIG.ScriptName, p_timestamp = n,
        })
    end)
end

_G.REN = {
    join = function(tid)
        local rr = callRPC("ren_get_session", { p_session_id = tostring(tid) })
        if not rr.success or not rr.body then return false end
        local o, d = pcall(function() return HttpService:JSONDecode(rr.body) end)
        if not o or type(d) ~= "table" or not d[1] or not d[1].job_id then return false end
        pcall(function()
            Teleport:TeleportToPlaceInstance(tonumber(d[1].place_id), d[1].job_id, player)
        end)
        return true
    end,
    refresh = doFullPush,
    method  = methodName,
    -- Ketik di console/executor: _G.REN.test()  → lihat status code + isi balasan Supabase
    test = function()
        local r = callRPC("ren_heartbeat", { p_session_id = sessionId, p_timestamp = os.time() })
        print("[REN] test →", "success=" .. tostring(r.success), "code=" .. tostring(r.code),
              tostring(r.body or r.err))
        return r
    end,
}

-- ═══════════════════════════════════════════════════════════════════
-- START (semua di thread terpisah supaya loader tidak ketahan)
-- ═══════════════════════════════════════════════════════════════════
pcall(function()
    table.insert(connections, Players.PlayerRemoving:Connect(function(l)
        if l == player then deleteSession() end
    end))
end)

task.spawn(function()
    doFullPush()
    trackExecute()
end)

-- Satu loop saja, berurutan (tidak ada request yang numpuk).
task.spawn(function()
    while alive() and not State.deleted do
        task.wait(CONFIG.HeartbeatInterval)
        if not alive() or State.deleted then break end
        local n = os.time()
        if n - State.lastFullPush >= CONFIG.FullPushInterval then
            doFullPush()
        else
            local r = callRPC("ren_heartbeat", { p_session_id = sessionId, p_timestamp = n })
            -- Kalau heartbeat gagal, paksa full push di tick berikutnya (self-heal)
            if not r.success then State.lastFullPush = 0 end
        end
    end
end)

print("[REN] Tracker v6.3 aktif via " .. methodName)
