-- ═══════════════════════════════════════════════════════════════════
-- LOG SYSTEM (single label, RichText, manual height)
-- ═══════════════════════════════════════════════════════════════════
local rawLogs = {}     -- plain text
local richLogs = {}    -- with color tags

local COLORS = {
    info = "#8ab4ff",
    ok   = "#57f287",
    err  = "#ff6b6b",
    warn = "#fee75c",
    dim  = "#828caa",
}

local function escapeRich(s)
    return tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function refreshLog()
    if not logLabel or not logLabel.Parent then return end
    logLabel.Text = table.concat(richLogs, "\n")

    task.defer(function()
        if not scroll or not scroll.Parent then return end
        local width = math.max(scroll.AbsoluteSize.X - 24, 100)
        local ok, bounds = pcall(function()
            return TextService:GetTextSize(
                logLabel.Text, 11, Enum.Font.Code,
                Vector2.new(width, math.huge)
            )
        end)
        local h = (ok and bounds and bounds.Y or (#rawLogs * 15)) + 24
        logLabel.Size = UDim2.new(1, -16, 0, h)
        scroll.CanvasSize = UDim2.new(0, 0, 0, h + 20)
        scroll.CanvasPosition = Vector2.new(0, math.max(0, h))
    end)
end

local function logLine(text, level)
    level = level or "info"
    print("[REN-DIAG]", text)   -- console backup
    table.insert(rawLogs, text)
    local c = COLORS[level] or COLORS.info
    table.insert(richLogs, `<font color="${c}">${escapeRich(text)}</font>`)
    refreshLog()
end

local function setStatus(text, level)
    if not statusBar or not statusBar.Parent then return end
    statusBar.Text = text
    statusBar.TextColor3 = (level == "ok" and Color3.fromRGB(87, 242, 135))
        or (level == "err" and Color3.fromRGB(255, 107, 107))
        or (level == "warn" and Color3.fromRGB(254, 231, 92))
        or Color3.fromRGB(138, 180, 255)
end

-- ═══════════════════════════════════════════════════════════════════
-- ERROR / SUCCESS STATE
-- ═══════════════════════════════════════════════════════════════════
local function showError(errMsg, hint)
    setStatus("❌ GAGAL", "err")
    title.Text = "❌ REN Tracker - Gagal"
    title.TextColor3 = Color3.fromRGB(255, 107, 107)
    stroke.Color = Color3.fromRGB(220, 60, 60)
    header.BackgroundColor3 = Color3.fromRGB(60, 20, 20)

    logLine("══════════════════════════════════", "err")
    logLine(errMsg, "err")
    if hint then
        logLine("", "info")
        logLine("💡 " .. hint, "warn")
    end
    logLine("══════════════════════════════════", "err")

    copyBtn.Visible = true
    copyBtn.MouseButton1Click:Connect(function()
        local full = table.concat(rawLogs, "\n")
        local copied, saved = false, false
        if setclipboard then
            local ok = pcall(setclipboard, full)
            if ok then copied = true end
        end
        if writefile then
            local ok = pcall(writefile, "ren_error_log.txt", full)
            if ok then saved = true end
        end
        if copied and saved then copyBtn.Text = "✅ Copied + File Saved"
        elseif copied then copyBtn.Text = "✅ Copied to Clipboard"
        elseif saved then copyBtn.Text = "✅ Saved: ren_error_log.txt"
        else copyBtn.Text = "❌ Copy Failed" end
        task.delay(3, function()
            if copyBtn and copyBtn.Parent then
                copyBtn.Text = "📋 Copy Error Log"
            end
        end)
    end)
end

local function showSuccess()
    setStatus("✅ Berhasil — tracker aktif", "ok")
    title.Text = "✅ REN Tracker - Aktif"
    title.TextColor3 = Color3.fromRGB(87, 242, 135)
    stroke.Color = Color3.fromRGB(87, 242, 135)
    header.BackgroundColor3 = Color3.fromRGB(20, 50, 30)

    task.delay(3, function()
        if not gui or not gui.Parent then return end
        local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, d in ipairs(frame:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                TweenService:Create(d, info, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
            elseif d:IsA("Frame") or d:IsA("ScrollingFrame") then
                TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
            elseif d:IsA("UIStroke") then
                TweenService:Create(d, info, { Transparency = 1 }):Play()
            end
        end
        task.wait(1)
        if gui and gui.Parent then gui:Destroy() end
    end)
end

-- ═══════════════════════════════════════════════════════════════════
-- HTTP DETECTION
-- ═══════════════════════════════════════════════════════════════════
local function tryRequest(url, body)
    local ok, res = pcall(request, {
        Url = url, Method = "POST",
        Headers = { apikey = CONFIG.KEY, ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok or not res then
        return { success = false, err = "request() threw: " .. tostring(res) }
    end
    local code = tonumber(res.StatusCode) or 0
    local rbody = tostring(res.Body or "")
    if code >= 200 and code < 300 then
        return { success = true, code = code, body = rbody }
    end
    return { success = false, code = code, body = rbody,
             err = "HTTP " .. code .. ": " .. tostring(res.StatusMessage or "") }
end

local function tryHttpRequest(url, body)
    local ok, res = pcall(http_request, {
        Url = url, Method = "POST",
        Headers = { apikey = CONFIG.KEY, ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok or not res then
        return { success = false, err = "http_request threw: " .. tostring(res) }
    end
    local code = tonumber(res.StatusCode) or 0
    local rbody = tostring(res.Body or "")
    if code >= 200 and code < 300 then
        return { success = true, code = code, body = rbody }
    end
    return { success = false, code = code, body = rbody,
             err = "HTTP " .. code .. ": " .. tostring(res.StatusMessage or "") }
end

local httpFn, methodName
if typeof(request) == "function" then
    httpFn, methodName = tryRequest, "request()"
elseif typeof(http_request) == "function" then
    httpFn, methodName = tryHttpRequest, "http_request()"
elseif syn and syn.request then
    httpFn, methodName = function(u,b)
        local ok, res = pcall(syn.request, {Url=u,Method="POST",
            Headers={apikey=CONFIG.KEY,["Content-Type"]="application/json"},Body=b})
        if not ok or not res then return {success=false, err="syn.request threw"} end
        local code = tonumber(res.StatusCode) or 0
        local rbody = tostring(res.Body or "")
        if code >= 200 and code < 300 then return {success=true, code=code, body=rbody} end
        return {success=false, code=code, body=rbody, err="HTTP "..code}
    end, "syn.request()"
end

local function callRPC(fnName, payload)
    local url = CONFIG.URL .. "/rest/v1/rpc/" .. fnName
    return httpFn(url, HttpService:JSONEncode(payload or {}))
end

