-- Matikan instance lama kalau script ini dieksekusi ulang.
-- Sebelumnya: tiap re-execute menambah loop heartbeat baru yang tidak pernah berhenti.
if type(genv.REN_TRACKER_STOP) == "function" then pcall(genv.REN_TRACKER_STOP) end
local myGen = (genv.REN_TRACKER_GEN or 0) + 1
genv.REN_TRACKER_GEN = myGen
local function alive() return genv.REN_TRACKER_GEN == myGen end

local CONFIG = {
    URL = "https://xtijiyyzqbxsfkeojoiv.supabase.co",
