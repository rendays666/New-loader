-- ║  HTTP                                                              ║
-- ╚═══════════════════════════════════════════════════════════════════╝
local function httpGet(url)
    local ok, r = pcall(function() return game:HttpGet(url, true) end)
    if ok and r and r ~= "" then return r end
    if syn and syn.request then
        local x = pcall(function() return syn.request({Url=url, Method="GET"}) end)
        if x and x.Body then return x.Body end
    end
    if http_request then
        local x = pcall(function() return http_request({Url=url, Method="GET"}) end)
        if x and x.Body then return x.Body end
    end
    if request then
        local x = pcall(function() return request({Url=url, Method="GET"}) end)
        if x and x.Body then return x.Body end
    end
    return nil
end

-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║  CLIPBOARD                                                         ║
-- ╚═══════════════════════════════════════════════════════════════════╝
local function copyToClipboard(text)
    local ok = pcall(function() setclipboard(tostring(text)) end)
    if ok then return true end
    ok = pcall(function() toclipboard(tostring(text)) end)
    return ok
end

-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║  DATA FETCHERS                                                     ║
-- ╚═══════════════════════════════════════════════════════════════════╝
local function getUniverseId(placeId)
    local body = httpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(placeId) .. "/universe")
    if not body then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if ok and data and tonumber(data.universeId) then return tonumber(data.universeId) end
    return nil
end

local function getGameInfo(universeId)
    local body = httpGet("https://games.roblox.com/v1/games?universeIds=" .. tostring(universeId))
    if not body then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if ok and data and data.data and data.data[1] then
        return data.data[1]
    end
    return nil
end

local function getCreatorName(gameInfo)
    if not gameInfo then return "?" end
    if gameInfo.creator then
        local ctype = gameInfo.creator.type or ""
        local cname = gameInfo.creator.name or "?"
        if ctype == "User" then return cname .. " (User)"
        elseif ctype == "Group" then return cname .. " (Group)"
        else return cname end
    end
    return "?"
end

-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║  BUILD DATA TABLE                                                  ║
-- ╚═══════════════════════════════════════════════════════════════════╝
local function gatherData()
    local placeId = game.PlaceId
    local universeId = getUniverseId(placeId) or game.GameId
    local gameInfo = getGameInfo(universeId)

    local players = #Players:GetPlayers()
    local maxPlayers = Players.MaxPlayers

    local data = {}

    -- GAME INFO
    local function add(section, label, value, copyable)
        table.insert(data, {section = section, label = label, value = tostring(value or "?"), copy = copyable ~= false})
    end

    add("GAME", "PlaceId", placeId)
    add("GAME", "UniverseId", universeId)
    add("GAME", "Game Name", gameInfo and gameInfo.name or "?")
    add("GAME", "Creator", getCreatorName(gameInfo))
    add("GAME", "Playing (global)", gameInfo and gameInfo.playing or "?")
    add("GAME", "Visits", gameInfo and gameInfo.visits or "?")
    add("GAME", "Created", gameInfo and gameInfo.created or "?")
    add("GAME", "Updated", gameInfo and gameInfo.updated or "?")

    -- SERVER INFO
    add("SERVER", "JobId", game.JobId ~= "" and game.JobId or "?")
    add("SERVER", "Players", players .. " / " .. maxPlayers)
    add("SERVER", "Place Version", game.PlaceVersion)
    add("SERVER", "Creator ID", game.CreatorId)
    add("SERVER", "Creator Type", tostring(game.CreatorType))
    add("SERVER", "Server Region", "auto-detect")

    -- PLAYER INFO
    add("PLAYER", "Name", player.Name)
    add("PLAYER", "Display Name", player.DisplayName)
    add("PLAYER", "UserId", player.UserId)
    add("PLAYER", "Account Age", player.AccountAge .. " hari")
    add("PLAYER", "Membership", tostring(player.MembershipType))

    return data, gameInfo, universeId
end

