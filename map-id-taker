    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local hasCopy = item.value ~= "?" and item.value ~= ""
    local value = Instance.new("TextLabel", row)
    value.Size = UDim2.new(1, hasCopy and -160 or -130, 1, 0)
    value.Position = UDim2.new(0, 120, 0, 0)
    value.BackgroundTransparency = 1
    value.Text = item.value
    value.TextColor3 = Color3.fromRGB(240, 240, 250)
    value.Font = Enum.Font.GothamBold
    value.TextSize = 11
    value.TextXAlignment = Enum.TextXAlignment.Left
    value.TextTruncate = Enum.TextTruncate.AtEnd

    if hasCopy then
        local copyBtn = Instance.new("TextButton", row)
        copyBtn.Size = UDim2.new(0, 44, 0, 22)
        copyBtn.Position = UDim2.new(1, -50, 0.5, -11)
        copyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 120)
        copyBtn.Text = "Copy"
        copyBtn.TextColor3 = Color3.new(1, 1, 1)
        copyBtn.Font = Enum.Font.GothamBold
        copyBtn.TextSize = 9
        copyBtn.BorderSizePixel = 0
        Instance.new("UICorner", copyBtn).CornerRadius = UDim.new(0, 5)

        copyBtn.MouseButton1Click:Connect(function()
            local ok = copyToClipboard(item.value)
            copyBtn.Text = ok and "✓" or "✗"
            copyBtn.BackgroundColor3 = ok and Color3.fromRGB(0, 220, 160) or Color3.fromRGB(200, 55, 55)
            task.delay(1, function()
                if copyBtn.Parent then
                    copyBtn.Text = "Copy"
                    copyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 120)
                end
            end)
        end)
    end

    orderIdx = orderIdx + 1
end

