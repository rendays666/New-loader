fStroke.Color = Color3.fromRGB(0, 220, 160); fStroke.Thickness = 2

-- Drag + tap detection (threshold 5px)
local fStart, fStartPos, fMoved = nil, nil, false

floatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fStart = input.Position
        fStartPos = floatBtn.Position
        fMoved = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if fStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - fStart
        if d.Magnitude > 5 then fMoved = true end
        floatBtn.Position = UDim2.new(
            fStartPos.X.Scale, fStartPos.X.Offset + d.X,
            fStartPos.Y.Scale, fStartPos.Y.Offset + d.Y
        )
    end
end)

floatBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if fStart and not fMoved then
            -- Tap (bukan drag) → toggle panel
            gui.Enabled = not gui.Enabled
        end
        fStart = nil
    end
end)

-- Kalau panel ditutup lewat tombol X, icon tetep ada
gui:GetPropertyChangedSignal("Enabled"):Connect(function()
    if floatBtn.Parent then
        floatBtn.BackgroundColor3 = gui.Enabled
            and Color3.fromRGB(0, 220, 160)
            or  Color3.fromRGB(0, 170, 120)
    end
end)

